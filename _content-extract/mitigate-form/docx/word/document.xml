<w:r w:rsidRPr="00B94CE4"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Project </w:t></w:r><w:r w:rsidR="00362AAC" w:rsidRPr="00B94CE4"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>acronym:</w:t></w:r><w:r w:rsidR="00B8006A" w:rsidRPr="00B8006A"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00B8006A"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>MITIGATE-HARM</w:t></w:r></w:p><w:p w14:paraId="64301380" w14:textId="6351DEED" w:rsidR="00362AAC" w:rsidRPr="00B94CE4" w:rsidRDefault="00362AAC" w:rsidP="00BA0977"><w:pPr><w:spacing w:after="0"/><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="00B94CE4"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>Staring and end year:</w:t></w:r><w:r w:rsidR="003E2FB0" w:rsidRPr="003E2FB0"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="003E2FB0"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>2026 – 2029</w:t></w:r></w:p><w:p w14:paraId="73A4EB53" w14:textId="01189268" w:rsidR="00362AAC" w:rsidRPr="00B94CE4" w:rsidRDefault="00362AAC" w:rsidP="00BA0977"><w:pPr><w:spacing w:after="0"/><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r w:rsidRPr="00B94CE4"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Funder organization: </w:t></w:r><w:r w:rsidR="00CA246F"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>Clean Energy Transition Partnership (CETP), Joint Call 2024 (proposal code CETP-2024-00024). The TU Delft contribution is funded by the Dutch Research Council (NWO) under the Horizon Europe programme</w:t></w:r></w:p><w:p w14:paraId="190867E7" w14:textId="52942994" w:rsidR="00362AAC" w:rsidRDefault="00BA0977" w:rsidP="00BA0977"><w:pPr><w:spacing w:after="0"/><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve">Webpage project (if available): </w:t></w:r><w:hyperlink r:id="rId10" w:history="1"><w:r w:rsidR="00DC5186"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="0563C1"/><w:u w:val="single"/></w:rPr><w:t>https://mitigate-harm.eu/</w:t></w:r></w:hyperlink></w:p><w:p w14:paraId="62ECFD22" w14:textId="1C190AA6" w:rsidR="00340C84" w:rsidRDefault="00340C84" w:rsidP="00BA0977"><w:pPr><w:spacing w:after="0"/><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>IE</w:t></w:r><w:r w:rsidR="00990EBE"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial" w:hint="eastAsia"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>PG</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t xml:space="preserve"> responsible staff: </w:t></w:r><w:r w:rsidR="00D07006"><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>Dr Aleksandra Lekić</w:t></w:r></w:p><w:p w14:paraId="020BB102" w14:textId="77777777" w:rsidR="00BA0977" w:rsidRPr="00B94CE4" w:rsidRDefault="00BA0977" w:rsidP="006132A6"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr></w:p><w:p w14:paraId="434AD8A3" w14:textId="581C12A0" w:rsidR="00103432" w:rsidRPr="00B94CE4" w:rsidRDefault="0079664D" w:rsidP="0079664D"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00B94CE4"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/></w:rPr><w:t>Overview</w:t></w:r></w:p><w:p w14:paraId="408A404F" w14:textId="73744ADB" w:rsidR="0079664D" w:rsidRPr="00B94CE4" w:rsidRDefault="00EC0C21"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>MITIGATE-HARM is a European research and innovation project that makes future power systems more resilient and reliable by identifying, assessing, and mitigating converter-driven instabilities and harmonic resonances in large-scale hybrid AC/DC power systems, including multi-terminal and multi-vendor HVDC grids. As grids integrate more renewable energy and power-electronic devices, new fast dynamics and stability challenges emerge that existing, vendor-specific tools cannot assess quickly enough. MITIGATE-HARM develops fast, non-vendor-specific stability-assessment tools built on two open-source platforms — Harmony (impedance-based analysis) and DPsim (eigenvalue-based analysis) — that support transmission system operators (TSOs) already at the early planning stage. By enabling rapid simulation and systematic mitigation strategies, the project enhances grid resilience, interoperability, and planning efficiency, facilitating the safe integration of up to 100% renewable energy.</w:t></w:r></w:p><w:p w14:paraId="12D1E980" w14:textId="77777777" w:rsidR="0079664D" w:rsidRPr="00B94CE4" w:rsidRDefault="0079664D"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00B94CE4"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/></w:rPr><w:t>Project description</w:t></w:r></w:p><w:p w14:paraId="0A2D94A2" w14:textId="77777777" w:rsidR="006D33D4" w:rsidRDefault="006D33D4" w:rsidP="006D33D4"><w:pPr><w:spacing w:after="120"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>The digitalisation of power systems and the large-scale integration of renewable energy sources have sharply increased the penetration of power-electronic (PE) equipment. Operating at high frequencies with complex switching dynamics, PE converters introduce fast new dynamics and expand the classical power-system stability classification to include converter-driven and resonance stability. Because a converter can behave as a negative resistance over a wide frequency range, its interaction with the rest of the grid can push the system into unstable operation, producing oscillations and resonances that, in severe cases, may lead to blackouts. These risks grow with the move toward hybrid AC/DC grids and multi-terminal, multi-vendor HVDC systems, and are aggravated by two roadblocks: the lack of standardisation for PE control and data exchange with TSO control rooms, and the vendor- and case-specific nature of current projects, which limits interoperability between equipment and future extensions.</w:t></w:r></w:p><w:p w14:paraId="11ABB006" w14:textId="77777777" w:rsidR="006D33D4" w:rsidRDefault="006D33D4" w:rsidP="006D33D4"><w:pPr><w:spacing w:after="120"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">MITIGATE-HARM addresses these challenges by developing a mathematical framework able to simulate all components of a hybrid power system for converter-driven stability assessment within a single toolbox, complemented by cross-validation across two approaches. On the impedance-based side, the project extends the open-source Harmony toolbox with new functionality to identify instabilities and resonances and to propose mitigation measures and wideband passivity, all implemented in C++. On the eigenvalue side, it extends the open-source DPsim solver to model, simulate, and perform eigenvalue analysis of hybrid AC/DC grids, and integrates DPsim as a solver within OPAL-RT's real-time simulation platform. The developments are verified and cross-validated on benchmark systems (an IEEE 9-bus system with HVDC links and a Nordic test system with PE </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:lastRenderedPageBreak/><w:t>converters) against commercial and open-source tools (PSCAD, Z-tool, OPAL-RT), and then applied to real-life, large-scale test cases provided by the TSO TenneT.</w:t></w:r></w:p><w:p w14:paraId="19F77BF7" w14:textId="028C7DE3" w:rsidR="0079664D" w:rsidRPr="000B4BD1" w:rsidRDefault="006D33D4" w:rsidP="006D33D4"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="D0CECE" w:themeColor="background2" w:themeShade="E6"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>Through this work, Harmony advances from TRL 3 to TRL 5 and the new DPsim capabilities from TRL 2–3 to TRL 5. Success is tracked by concrete KPIs: below 1% inaccuracy on calculated instabilities and resonances relative to commercial tools, at least an order-of-magnitude reduction in simulation time (from minutes to seconds), and more than 30% reduction of identified instabilities through the proposed mitigation and wideband-passivity measures. The project also establishes open benchmark suites and public datasets for dynamic-model validation via EMT–HIL measurements, published through CRESYM's Collaborative Dynamic Library. Together, these results give TSOs proactive tools to detect, prevent, and diagnose instabilities and resonances, strengthening the resilience, interoperability, and planning of future hybrid AC/DC grids and supporting the safe integration of up to 100% renewable energy.</w:t></w:r></w:p><w:p w14:paraId="465B6981" w14:textId="77777777" w:rsidR="0079664D" w:rsidRPr="00B94CE4" w:rsidRDefault="0079664D"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0ED040DF" w14:textId="07DDB57D" w:rsidR="006132A6" w:rsidRPr="00B94CE4" w:rsidRDefault="006132A6" w:rsidP="006132A6"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00B94CE4"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/></w:rPr><w:t>Intended deliverables</w:t></w:r></w:p><w:p w14:paraId="0803DF19" w14:textId="77777777" w:rsidR="00CD1F95" w:rsidRDefault="00CD1F95" w:rsidP="00CD1F95"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:after="60" w:line="240" w:lineRule="auto"/><w:contextualSpacing w:val="0"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">Advanced Harmony toolbox: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>an extended open-source C++ framework adding instability and resonance identification, mitigation measures, and wideband passivity, with user-friendly interfaces and field configurability.</w:t></w:r></w:p><w:p w14:paraId="17928718" w14:textId="77777777" w:rsidR="00CD1F95" w:rsidRDefault="00CD1F95" w:rsidP="00CD1F95"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:after="60" w:line="240" w:lineRule="auto"/><w:contextualSpacing w:val="0"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">Enhanced DPsim toolbox: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>modelling, simulation, and eigenvalue analysis of hybrid AC/DC grids, plus integration of the DPsim solver into OPAL-RT's real-time simulation platform, released open-source with documentation and examples.</w:t></w:r></w:p><w:p w14:paraId="6B55625B" w14:textId="77777777" w:rsidR="00CD1F95" w:rsidRDefault="00CD1F95" w:rsidP="00CD1F95"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:after="60" w:line="240" w:lineRule="auto"/><w:contextualSpacing w:val="0"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">Open benchmark suites and public datasets: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>standardised testbeds for dynamic-model validation focused on resonance paths and instability identification, validated with EMT–HIL measurements and published via CRESYM's Collaborative Dynamic Library (CoLib).</w:t></w:r></w:p><w:p w14:paraId="45AB3791" w14:textId="77777777" w:rsidR="00CD1F95" w:rsidRDefault="00CD1F95" w:rsidP="00CD1F95"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:after="60" w:line="240" w:lineRule="auto"/><w:contextualSpacing w:val="0"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>Verification, cross-validation, and application on real-life TenneT test cases, with evaluation of the technical KPIs and a preliminary pan-European scalability analysis.</w:t></w:r></w:p><w:p w14:paraId="547F8EEA" w14:textId="77777777" w:rsidR="00CD1F95" w:rsidRDefault="00CD1F95" w:rsidP="00CD1F95"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:after="60" w:line="240" w:lineRule="auto"/><w:contextualSpacing w:val="0"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>Scientific dissemination: at least three gold open-access journal papers and three conference papers, plus workshops, webinars, tutorials, and special sessions.</w:t></w:r></w:p><w:p w14:paraId="3C9A8DA9" w14:textId="77777777" w:rsidR="00CD1F95" w:rsidRDefault="00CD1F95" w:rsidP="00CD1F95"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:after="60" w:line="240" w:lineRule="auto"/><w:contextualSpacing w:val="0"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>Project communication and legacy: project website, LinkedIn, and Zenodo channels; a Data Management Plan; training modules; and long-term maintenance of the toolboxes as Linux Foundation Energy projects.</w:t></w:r></w:p><w:p w14:paraId="10510B76" w14:textId="77777777" w:rsidR="006132A6" w:rsidRPr="00B94CE4" w:rsidRDefault="006132A6"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="3BEB4B3C" w14:textId="2FEEF0A4" w:rsidR="0079664D" w:rsidRPr="00B94CE4" w:rsidRDefault="0079664D"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00B94CE4"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/></w:rPr><w:t>Project partners</w:t></w:r></w:p><w:p w14:paraId="5BB1844B" w14:textId="77777777" w:rsidR="00841DD9" w:rsidRDefault="00841DD9" w:rsidP="00841DD9"><w:pPr><w:spacing w:after="120"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="000000"/></w:rPr><w:t>The MITIGATE-HARM consortium brings together six partners from four European countries. It is coordinated by Delft University of Technology (TU Delft, Netherlands) and includes three academic institutions active in power-electronics-dominated power systems — TU Delft, the Aristotle University of Thessaloniki (AUTH, Greece), and RWTH Aachen University (Germany) — together with the transmission system operator TenneT TSO GmbH (Germany), the real-time hardware-in-the-loop simulator manufacturer OPAL-RT Germany GmbH (Germany), and CRESYM (Collaborative Research for Energy System Modelling, Belgium), a non-profit association fostering open-source energy-system research between academia and industry. This mix of academia, a TSO, an industrial simulator manufacturer, and an open-source organisation, spanning northern and south-eastern Europe, combines complementary expertise in stability analysis, modelling and simulation, real-time testing, and dissemination, and builds on the partners' long track record of joint projects such as Harmony, InterOPERA, HVDC-WISE, Inter-oPEn, and EASY-RES.</w:t></w:r></w:p><w:p w14:paraId="689C6B8E" w14:textId="7FF5FAF4" w:rsidR="0079664D" w:rsidRPr="00B94CE4" w:rsidRDefault="00841DD9"><w:pPr><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="7E47AD99" wp14:editId="51DB79D6"><wp:extent cx="1881655" cy="1881655"/><wp:effectExtent l="0" t="0" r="4445" b="4445"/><wp:docPr id="1620203135" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 1"/><pic:cNvPicPr><a:pic